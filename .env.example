# ─── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Channel that receives alerts (Developer Mode on → right-click channel → Copy Channel ID)
DISCORD_ALERT_CHANNEL_ID=
# Your server's ID. Recommended: slash commands appear instantly and work only there.
DISCORD_GUILD_ID=
# Who may use /nas commands. Leave both empty to allow everyone in the server.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_ROLE_IDS=
# Ping a role or a user on urgent notifications (role wins if both are set)
DISCORD_MENTION_ROLE_ID=
DISCORD_MENTION_USER_ID=
# Alert level at or above which the mention is added: WARNING, ERROR, CRITICAL (default), ALERT, EMERGENCY
MENTION_MIN_LEVEL=CRITICAL
# true = command replies are visible only to whoever ran the command
DISCORD_EPHEMERAL_REPLIES=false
# Post a short "bot online" message on startup
ANNOUNCE_STARTUP=true

# ─── TrueNAS ──────────────────────────────────────────────────────────────────
# Host, IP or URL. Bare host → wss://host/api/current. Tailnet name or 100.x IP both work.
TRUENAS_URL=truenas.your-tailnet.ts.net
# The user the API key belongs to (create a dedicated user with the "Readonly Admin" role)
TRUENAS_USERNAME=nasbot
# API key, format "<id>-<key>". Or put it in a file and set TRUENAS_API_KEY_FILE instead.
TRUENAS_API_KEY=
# plain = TrueNAS 25.04 / 25.10 · scram = TrueNAS 26-beta / 27+ (key never sent over the wire)
TRUENAS_AUTH=plain
# TrueNAS ships a self-signed certificate, so this is false here. The link is still encrypted
# (and over Tailscale, also WireGuard-authenticated). Set true if you install a trusted cert.
TRUENAS_VERIFY_SSL=false
# SCRAM channel binding (26+ only). Must be false if TRUENAS_URL is plain ws:// / http://
TRUENAS_CHANNEL_BINDING=true

# ─── Monitoring ───────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60
# Consecutive failed polls before "NAS unreachable" is posted (3 × 60s = 3 minutes)
UNREACHABLE_AFTER_FAILURES=3
# Lowest TrueNAS alert level to forward: INFO, NOTICE, WARNING (default), ERROR, CRITICAL
ALERT_MIN_LEVEL=WARNING
# Comma-separated alert classes to never forward (class names show in each alert's footer)
ALERT_IGNORE_CLASSES=
# Notify when apps crash, stop, or recover
WATCH_APPS=true
# Daily status digest at HH:MM in DIGEST_TZ (leave empty to disable)
DIGEST_TIME=
DIGEST_TZ=UTC
# Dead-man's switch: healthchecks.io or Uptime Kuma push URL. Catches the case the bot
# can't report itself — the machine running it going offline.
HEALTHCHECK_PING_URL=

# ─── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
